# Copy this file to .env and fill in the two values from your Supabase project:
#   Supabase dashboard -> Settings -> API Keys
#
# The publishable key starts with "sb_publishable_". It is designed to ship in
# browser code, so it is safe in this file's .env sibling and in Netlify's
# environment variables. Never put the SECRET key (sb_secret_...) here: it
# bypasses row level security and must stay server-side.
#
# Leave both blank and the app runs entirely on browser localStorage. Useful for
# a first run, but nothing syncs between devices.

VITE_SUPABASE_URL=https://xzqvvgcsyhlbfscrwmei.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EYA8JB2xRxxf2kUAn5mClg_dgJikTMi

# Older projects issued a JWT-style key labelled "anon" instead. That still works
# and the app will pick it up, but Supabase retires it at the end of 2026.
# VITE_SUPABASE_ANON_KEY=
